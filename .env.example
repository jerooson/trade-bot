# Copy this file to ".env" and fill in real values there.
# .env is gitignored; .env.example is committed.
# NEVER put real secrets in .env.example.

# Your Discord USER token (NOT a bot token).
# How to get it: open Discord in a browser, F12 -> Network tab -> filter "/api" ->
#   pick any request -> Headers -> "Authorization" header value.
# KEEP THIS SECRET. Anyone with this token controls your account.
DISCORD_USER_TOKEN=

# Comma-separated list of channel IDs to listen to.
# To get a channel ID: enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click the channel -> Copy Channel ID.
# Or just read it from the channel URL: discord.com/channels/<guild>/<channel_id>
DISCORD_CHANNEL_IDS=

# Where to append parsed signals as JSONL.
SIGNAL_LOG_PATH=./logs/signals.jsonl
