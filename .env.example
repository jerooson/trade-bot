# Copy this file to ".env" and fill in real values there.
# .env is gitignored; .env.example is committed.
# NEVER put real secrets in .env.example.

# Your Discord USER token (NOT a bot token).
# How to get it: open Discord in a browser, F12 -> Network tab -> filter "/api" ->
#   pick any request -> Headers -> "Authorization" header value.
# KEEP THIS SECRET. Anyone with this token controls your account.
DISCORD_USER_TOKEN=

# Comma-separated list of LIVE-SIGNAL channel IDs (structured PLAN/TRIGGER/PROFIT
# posts -- the day-trade channel). Parsed by bot/parser.py.
# Get the ID from the channel URL: discord.com/channels/<guild>/<channel_id>
DISCORD_CHANNEL_IDS=

# Comma-separated list of TRADE-PLAN channel IDs (free-form swing-trade write-ups
# with charts). Parsed by bot/plan_parser.py. Optional -- leave blank if you only
# want live signals.
DISCORD_PLAN_CHANNEL_IDS=

# Comma-separated list of SWING-TRADE EXECUTION channel IDs (structured ENTRY /
# ADD / REDUCE / CLOSE / STOP_TRIGGER / STOP_UPDATE posts). Parsed by
# bot/swing_parser.py. Optional.
DISCORD_SWING_CHANNEL_IDS=

# Where to append parsed live signals as JSONL.
SIGNAL_LOG_PATH=./logs/signals.jsonl

# Where to append parsed trade plans as JSONL.
PLAN_LOG_PATH=./logs/plans.jsonl

# Where to append parsed swing-trade actions as JSONL.
SWING_LOG_PATH=./logs/swings.jsonl
