# Copy this file to ".env" and fill in real values there.
# .env is gitignored; .env.example is committed.
# NEVER put real secrets in .env.example.

# Your Discord USER token (NOT a bot token).
# How to get it: open Discord in a browser, F12 -> Network tab -> filter "/api" ->
#   pick any request -> Headers -> "Authorization" header value.
# KEEP THIS SECRET. Anyone with this token controls your account.
DISCORD_USER_TOKEN=

# Comma-separated list of LIVE-SIGNAL channel IDs (structured PLAN/TRIGGER/PROFIT
# posts -- the day-trade channel). Parsed by bot/parser.py.
# Get the ID from the channel URL: discord.com/channels/<guild>/<channel_id>
DISCORD_CHANNEL_IDS=

# Comma-separated list of TRADE-PLAN channel IDs (free-form swing-trade write-ups
# with charts). Parsed by bot/plan_parser.py. Optional -- leave blank if you only
# want live signals.
DISCORD_PLAN_CHANNEL_IDS=

# Comma-separated list of SWING-TRADE EXECUTION channel IDs (structured ENTRY /
# ADD / REDUCE / CLOSE / STOP_TRIGGER / STOP_UPDATE posts). Parsed by
# bot/swing_parser.py. Optional.
DISCORD_SWING_CHANNEL_IDS=

# Heat day-trade idea source. Only messages authored by the listed stable
# Discord user IDs are accepted; author names are never trusted. Explicit
# numeric long-equity breakouts can auto-queue, while chart-only ideas wait for
# Dashboard approval. Both values are required together.
DISCORD_HEAT_CHANNEL_IDS=
DISCORD_HEAT_AUTHOR_IDS=

# Where to append parsed live signals as JSONL.
SIGNAL_LOG_PATH=./logs/signals.jsonl

# Where to append parsed trade plans as JSONL.
PLAN_LOG_PATH=./logs/plans.jsonl

# Where to append parsed swing-trade actions as JSONL.
SWING_LOG_PATH=./logs/swings.jsonl

# Heat ideas and downloaded chart images. Discord attachment URLs expire, so
# the listener saves eligible images immediately (8 MiB maximum by default).
HEAT_IDEAS_LOG_PATH=./logs/heat_ideas.jsonl
HEAT_ATTACHMENTS_DIR=./logs/heat_attachments
HEAT_MAX_ATTACHMENT_BYTES=8388608

# -----------------------------------------------------------------------------
# Executor (DRY_RUN mode — Phase 1).
# The executor reads logs/swings.jsonl, applies sizing rules, and writes
# "proposed orders" to logs/proposed_orders.jsonl. It does NOT place real
# orders. Connecting Robinhood MCP to Codex does not make it callable by this
# background Python process. See docs/robinhood-mcp.md for the supported setup.
# -----------------------------------------------------------------------------

# Per-ticker budget. Each ENTRY 1/1 deploys this much; ENTRY 1/3 deploys 1/3 of it.
EXECUTOR_BUDGET_PER_TICKER=20

# Maximum concurrent open tickers. Once full, new ENTRY signals are rejected
# until something is closed/stopped out.
EXECUTOR_MAX_OPEN_TICKERS=10

# DRY_RUN is the only supported mode. LIVE fails loudly by design.
EXECUTOR_MODE=DRY_RUN

# Where to persist the virtual book + the append-only decision log.
EXECUTOR_BOOK_PATH=./logs/virtual_book.json
EXECUTOR_ORDERS_PATH=./logs/proposed_orders.jsonl

# Poll interval for tailing the swings log. 1s is fine; lower for snappier UX.
EXECUTOR_POLL_INTERVAL_S=1.0

# (Optional) ISO 8601 cutoff for replay. Any swing action whose received_at
# is at or before this timestamp is skipped during the startup replay, so
# the virtual book starts fresh from after this moment. Useful when your
# real broker account is fresh / empty and you don't want the bot to
# pretend it bought into Will's prior signals. Leave blank to replay all
# historical signals. Example: 2026-06-08T18:54:08+00:00
EXECUTOR_REPLAY_FROM=

# -----------------------------------------------------------------------------
# Day-trade PLAN engine (VPS host process; places real Agentic-account orders).
# Poll slowly while far from a trigger and faster near a trigger/open position.
# Fractional entries re-check last/bid/ask immediately before a regular-hours
# market order; prices above the cap or spreads above the threshold are skipped.
# -----------------------------------------------------------------------------
DAY_TRADE_BUDGET_USD=20
DAY_TRADE_FAR_POLL_INTERVAL_S=15
DAY_TRADE_NEAR_POLL_INTERVAL_S=5
DAY_TRADE_NEAR_TRIGGER_PCT=0.5
DAY_TRADE_ENTRY_LIMIT_OFFSET_PCT=0.2
DAY_TRADE_ENTRY_MAX_SPREAD_PCT=0.2
DAY_TRADE_ENTRY_ORDER_TTL_S=30
DAY_TRADE_SCHEDULER_TICK_S=1
DAY_TRADE_MAX_HEAT_PLANS_PER_DAY=3

# -----------------------------------------------------------------------------
# Phone push notifications (optional).
# Set NTFY_TOPIC to a unique string YOU choose. Install the ntfy app on your
# phone, subscribe to that same topic, and the executor will push every
# decision to your phone. Leave blank to disable (executor still logs to disk).
#   1. Pick a unique topic (long random string): jasso-trade-bot-AbCdEfGhIj
#   2. Install ntfy app: https://ntfy.sh/app
#   3. In the app, subscribe to that exact topic name
#   4. Set NTFY_TOPIC=jasso-trade-bot-AbCdEfGhIj below
# -----------------------------------------------------------------------------
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# -----------------------------------------------------------------------------
# Robinhood auto-trader (VPS host process; places real Agentic-account orders).
# Reviews only fresh accepted ENTRY buys and REDUCE sells. The worker verifies
# the executor's $20-per-ticker proportional math before invoking Codex CLI.
# -----------------------------------------------------------------------------
SHADOW_REVIEW_LEDGER_PATH=./logs/robinhood_shadow_reviews.jsonl
SHADOW_REVIEW_CODEX_COMMAND=codex
SHADOW_REVIEW_MAX_AGE_S=300
SHADOW_REVIEW_POLL_INTERVAL_S=1
SHADOW_REVIEW_CODEX_TIMEOUT_S=120
SHADOW_REVIEW_PLACE_ORDERS=true
